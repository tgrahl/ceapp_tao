# TAO Community Edition – single-container image (nginx + php-fpm via supervisord)
# for Azure Container Apps.
#
# Code lives in the image. Only the two directories TAO writes to at runtime are
# expected to be mounted from Azure Files:
#   /var/www/html/config   (generated by the installer)
#   /var/www/html/data     (items, tests, results, media, PHP sessions)

# Defaults reproduce the known-good setup: package-tao's composer.lock
# (TAO 2022.11.6) on PHP 8.1. That lock requires PHP < 8.2.
# For a newer TAO, pass e.g. --build-arg PHP_VERSION=8.3 --build-arg TAO_COMMUNITY_VERSION=2026.11
ARG PHP_VERSION=8.1
FROM php:${PHP_VERSION}-fpm-bookworm

# Empty = use package-tao's composer.lock as-is.
ARG TAO_COMMUNITY_VERSION=
ARG PACKAGE_TAO_REF=master

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      nginx supervisor git unzip ca-certificates nodejs npm \
      libpng-dev libjpeg-dev libpq-dev libzip-dev libzstd-dev libicu-dev \
 && docker-php-ext-configure gd --with-jpeg \
 && docker-php-ext-install -j"$(nproc)" \
      pdo_mysql mysqli pdo_pgsql gd opcache zip calendar sockets pcntl intl \
 && pecl install igbinary redis \
 && docker-php-ext-enable igbinary redis \
 && apt-get purge -y --auto-remove libpng-dev libjpeg-dev libpq-dev libzip-dev libzstd-dev libicu-dev \
 && apt-get install -y --no-install-recommends libpng16-16 libjpeg62-turbo libpq5 libzip4 libicu72 \
 && rm -rf /var/lib/apt/lists/* /tmp/pear

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html
RUN rm -rf /var/www/html/* \
 && git clone --depth 1 --branch "${PACKAGE_TAO_REF}" https://github.com/oat-sa/package-tao.git /tmp/package-tao \
 && cp /tmp/package-tao/index.php /tmp/package-tao/favicon.ico /tmp/package-tao/composer.json /tmp/package-tao/composer.lock . \
 && rm -rf /tmp/package-tao \
 && export COMPOSER_ALLOW_SUPERUSER=1 COMPOSER_NPM_BRIDGE_DISABLE=1 \
 && composer config --no-plugins allow-plugins true \
 && if [ -n "${TAO_COMMUNITY_VERSION}" ]; then \
      composer require --no-update "oat-sa/tao-community:${TAO_COMMUNITY_VERSION}" \
      && rm -f composer.lock \
      && composer update --no-dev --prefer-dist --no-interaction --optimize-autoloader; \
    else \
      composer install --no-dev --prefer-dist --no-interaction --optimize-autoloader; \
    fi \
 && composer clear-cache \
 # Front-end runtime libs (e.g. tao/views/node_modules/@oat-sa/tao-core-libs/dist/select2.js).
 # Done here instead of via composer-npm-bridge: in TAO 2022.11 tao/views/package-lock.json
 # is out of sync with package.json (git+ssh entry), so `npm ci` fails. Fall back to
 # `npm install` from package.json (exact versions) with npm-6-style peer resolution.
 && for pj in */views/package.json; do \
      d="$(dirname "$pj")"; echo "npm: $d"; \
      npm ci --omit=dev --no-audit --no-fund --prefix "$d" \
      || { rm -f "$d/package-lock.json" \
           && npm install --omit=dev --no-audit --no-fund --legacy-peer-deps --prefix "$d"; } \
      || exit 1; \
    done \
 && test -f tao/views/node_modules/@oat-sa/tao-core-libs/dist/select2.js \
 # Client-side translation bundles (tao/views/locales/<lang>/messages.json). The installer writes
 # them into the code tree, which isn't shared between containers in Azure (the install runs in
 # a separate job). Without them the login page renders no login form. Generate them here, with
 # TAO's tool meant for exactly this, so every container has them.
 && php tao/scripts/tools/GenerateTranslationBundles.php -p /var/www/html \
 && test -f tao/views/locales/en-US/messages.json \
 && npm cache clean --force \
 && apt-get purge -y --auto-remove nodejs npm \
 && mkdir -p config data \
 && chown -R www-data:www-data /var/www/html

COPY php.ini       /usr/local/etc/php/conf.d/zz-tao.ini
COPY php-fpm.conf  /usr/local/etc/php-fpm.d/zz-tao.conf
COPY nginx.conf    /etc/nginx/sites-available/default
COPY supervisord.conf /etc/supervisor/conf.d/tao.conf
COPY entrypoint.sh tao-install.sh tao-sync-db-config.php tao-reset-admin-password.php /usr/local/bin/
RUN chmod +x /usr/local/bin/entrypoint.sh /usr/local/bin/tao-install.sh \
 && ln -sf /dev/stdout /var/log/nginx/access.log \
 && ln -sf /dev/stderr /var/log/nginx/error.log

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/supervisord.conf"]
